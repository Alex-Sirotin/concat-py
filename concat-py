#!/usr/bin/env python3
import os
import sys
import fnmatch
import argparse

parser = argparse.ArgumentParser()
parser.add_argument("path", nargs="?", default=".")
parser.add_argument("--mask", default="")
parser.add_argument("--exclude", default="")
parser.add_argument("--exclude_dirs", default="")

args = parser.parse_args()

path = os.path.abspath(args.path)
cwd = os.path.abspath(os.getcwd())

include_masks = [m.strip() for m in args.mask.split(",") if m.strip()]
exclude_masks = [m.strip() for m in args.exclude.split(",") if m.strip()]
exclude_dir_masks = [m.strip() for m in args.exclude_dirs.split(",") if m.strip()]

# Определяем базу для относительного пути
base = cwd if path.startswith(cwd) else path

def match_masks(name: str) -> bool:
    if include_masks and not any(fnmatch.fnmatch(name, m) for m in include_masks):
        return False
    if exclude_masks and any(fnmatch.fnmatch(name, m) for m in exclude_masks):
        return False
    return True

for root, dirs, files in os.walk(path):
    dirs[:] = [
        d for d in dirs
        if not any(
            os.path.relpath(os.path.join(root, d), path).startswith(p)
            for p in exclude_dir_masks
        )
    ]

    for f in files:
        if not match_masks(f):
            continue

        full = os.path.join(root, f)
        rel = os.path.relpath(full, base)

        print(f"=== FILE: {rel} ===")
        print()

        try:
            with open(full, "r", encoding="utf-8", errors="replace") as fp:
                sys.stdout.write(fp.read())
        except Exception as e:
            print(f"[ERROR READING FILE: {e}]")

        print()
